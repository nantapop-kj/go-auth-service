# ---------- App
APP_NAME=go-auth-service
APP_ENV=dev

# ---------- Postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=user
PG_PASSWORD=user1234
PG_DATABASE=data-base-name
PG_SCHEMA=public
PG_SSL_MODE=disable

# ---------- Redis
REDIS_ADDRESS=localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=redis1234
REDIS_DB=0

# ---------- Server
SERVER_PORT=3001
CORS_ORIGINS=http://localhost:3000
PROXY_HEADER=

# ---------- JWT
JWT_SECRET=jwt-secret-must-be-at-least-32-chars
JWT_ISSUER=go-auth-service
JWT_AUDIENCE=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---------- Login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m

# ---------- Cookie
COOKIE_ENABLED=true
COOKIE_NAME=access_token
COOKIE_REFRESH_NAME=refresh_token
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
